  "cells": [
    {
      "cell_type": "markdown",
      "id": "ad30f0c6",
      "metadata": {},
      "source": [
        "## E4 — Latent interpolation + local neighborhood consistency (Kaggle)\\n",
        "\\n",
        "This notebook demonstrates that the VAE latent space is **smooth** and **locally consistent**:\\n",
        "- **Interpolation** between two anchor latents (8–16 steps)\\n",
        "- **Neighborhood sampling** around several anchors and comparison of within- vs between-anchor variation\\n",
        "\\n",
        "We keep this simple and portfolio-friendly by comparing generated samples using a **music-stat feature vector**\\n",
        "(density/polyphony/intensity/velocity summaries + pitch-class histogram).\\n",
        "\\n",
        "Outputs: `artifacts/eval_latent_sampling/`\\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a7b86df0",
      "metadata": {},
      "outputs": [],
      "source": [
        "from __future__ import annotations\n",
        "\n",
        "import json\n",
        "import math\n",
        "import random\n",
        "from dataclasses import dataclass\n",
        "from pathlib import Path\n",
        "from typing import Any\n",
        "\n",
        "import numpy as np\n",
        "import torch\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "IS_KAGGLE = Path('/kaggle').exists() and Path('/kaggle/input').exists()\n",
        "WORKING_ROOT = Path('/kaggle/working') if IS_KAGGLE else (Path.cwd() / 'artifacts' / 'local_eval')\n",
        "OUT_DIR = (WORKING_ROOT / 'artifacts' / 'eval_latent_sampling').resolve()\n",
        "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "print('OUT_DIR:', OUT_DIR)\n",
        "\n",
        "import sys\n",
        "repo_root = (Path.cwd().parents[1] if (Path.cwd().name == 'notebooks') else Path.cwd())\n",
        "ml_src = (repo_root / 'ml' / 'src').resolve()\n",
        "if str(ml_src) not in sys.path:\n",
        "    sys.path.insert(0, str(ml_src))\n",
        "\n",
        "from musicgen.inference.tokenizer import load_remi_tokenizer\n",
        "from musicgen.inference.generate import GenerationConfig, generate_remi_tokens\n",
        "from musicgen.data.memmap_dataset import MemmapMusicDataset\n",
        "from musicgen.eval.attributes import compute_raw_attributes_per_bar_from_tokens\n",
        "\n",
        "TOK = load_remi_tokenizer()\n",
        "DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print('device:', DEVICE)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "b0e9d7b5",
      "metadata": {},
      "outputs": [],
      "source": [
        "@dataclass(frozen=True)\n",
        "class VaeSpec:\n",
        "    name: str\n",
        "    model_type: str  # 'vae' or 'simple_vae'\n",
        "    ckpt_path: str\n",
        "    block_size: int = 1024\n",
        "    bars_per_sample: int = 8\n",
        "\n",
        "\n",
        "VAE_SPECS = [\n",
        "    VaeSpec('simple_v2', 'simple_vae', 'ml/src/musicgen/runs/simple_v2/ckpt.pt', 1024),\n",
        "    VaeSpec('vae_v3', 'vae', 'ml/src/musicgen/runs/vae_v3/ckpt.pt', 1024),\n",
        "]\n",
        "\n",
        "# Sampling controls\n",
        "TEMP = 1.0\n",
        "TOP_P = 0.9\n",
        "BASE_ATTR = [3, 3, 3, 3]\n",
        "\n",
        "# Neighborhood + interpolation sizes\n",
        "N_ANCHORS = 4\n",
        "M_NEIGHBOR = 50\n",
        "SIGMA = 0.15\n",
        "INTERP_STEPS = 9  # includes endpoints\n",
        "\n",
        "print('anchors:', N_ANCHORS, 'neighbor samples:', M_NEIGHBOR, 'sigma:', SIGMA, 'interp steps:', INTERP_STEPS)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "b8bb7f7e",
      "metadata": {},
      "outputs": [],
      "source": [
        "def load_model(model_type: str, ckpt_path: str, *, block_size: int, bars: int) -> torch.nn.Module:\n",
        "    from musicgen.inference.service import _load_checkpoint as _load_ckpt  # type: ignore\n",
        "    from musicgen.inference.service import _build_model as _build_model  # type: ignore\n",
        "    from musicgen.inference.service import _resolve_ckpt_path as _resolve_ckpt_path  # type: ignore\n",
        "\n",
        "    ckpt = _load_ckpt(_resolve_ckpt_path(ckpt_path))\n",
        "    model = _build_model(model_type, ckpt, block_size=block_size, bars=bars)\n",
        "    model.to(DEVICE)\n",
        "    model.eval()\n",
        "    return model\n",
        "\n",
        "\n",
        "def uniform_attrs(v4: list[int], bars: int = 8) -> torch.Tensor:\n",
        "    a = torch.tensor([v4 for _ in range(bars)], dtype=torch.long, device=DEVICE)\n",
        "    return a.unsqueeze(0)  # [1,bars,4]\n",
        "\n",
        "\n",
        "def feature_vector_from_tokens(tokens: list[int], *, bars: int) -> np.ndarray:\n",
        "    # Simple feature vector: [mean attrs (4), pitch-class histogram (12)]\n",
        "    raw_bars = compute_raw_attributes_per_bar_from_tokens(\n",
        "        tokens,\n",
        "        id_to_token=TOK.id_to_token,\n",
        "        bar_token_id=int(TOK.bar_id),\n",
        "        bars_per_sample=bars,\n",
        "    )\n",
        "    raw = np.asarray(raw_bars, dtype=float)\n",
        "    mean4 = raw.mean(axis=0)\n",
        "\n",
        "    pc = np.zeros((12,), dtype=float)\n",
        "    for tid in tokens:\n",
        "        tok = TOK.id_to_token.get(int(tid), '')\n",
        "        if tok.startswith('Pitch_'):\n",
        "            p = int(tok.split('_', 1)[1])\n",
        "            pc[p % 12] += 1.0\n",
        "    if pc.sum() > 0:\n",
        "        pc = pc / pc.sum()\n",
        "\n",
        "    return np.concatenate([mean4.astype(np.float32), pc.astype(np.float32)], axis=0)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "92af9f6b",
      "metadata": {},
      "outputs": [],
      "source": [
        "# Load test split and choose anchors.\n",
        "TEST_SPLIT = (repo_root / 'artifacts' / 'preprocessed_memmap' / 'test').resolve()\n",
        "ds = MemmapMusicDataset(TEST_SPLIT)\n",
        "\n",
        "rng = np.random.default_rng(123)\n",
        "anchor_idx = rng.choice(len(ds), size=N_ANCHORS, replace=False).tolist()\n",
        "anchor_idx\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "e2b0c0a4",
      "metadata": {},
      "outputs": [],
      "source": [
        "def encode_mu(model: torch.nn.Module, x_tokens: np.ndarray) -> np.ndarray:\n",
        "    X = torch.tensor(x_tokens[None, :], dtype=torch.long, device=DEVICE)\n",
        "    enc = getattr(model, 'encoder', None)\n",
        "    if enc is None:\n",
        "        raise ValueError('Model has no .encoder')\n",
        "    mu, logvar = enc(X)\n",
        "    return mu[0].detach().cpu().numpy().astype(np.float32)\n",
        "\n",
        "\n",
        "def generate_with_z(model_type: str, model: torch.nn.Module, *, z: np.ndarray, bars: int, block: int, seed: int) -> list[int]:\n",
        "    z_t = torch.tensor(z[None, :], dtype=torch.float32, device=DEVICE)\n",
        "    attrs = uniform_attrs(BASE_ATTR, bars=bars)\n",
        "\n",
        "    cfg = GenerationConfig(block_size=block, bars_per_sample=bars, temperature=TEMP, top_p=TOP_P)\n",
        "    tokens = generate_remi_tokens(\n",
        "        model_type=model_type,  # type: ignore[arg-type]\n",
        "        model=model,\n",
        "        attributes=attrs,\n",
        "        pad_id=TOK.pad_id,\n",
        "        bos_id=TOK.bos_id,\n",
        "        bar_id=TOK.bar_id,\n",
        "        id_to_token=TOK.id_to_token,\n",
        "        cfg=cfg,\n",
        "        device=DEVICE,\n",
        "        z_p=z_t,\n",
        "        seed=int(seed),\n",
        "    )\n",
        "    return tokens\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "b2d9fce3",
      "metadata": {},
      "outputs": [],
      "source": [
        "summary: dict[str, Any] = {\n",
        "    'config': {\n",
        "        'N_ANCHORS': N_ANCHORS,\n",
        "        'M_NEIGHBOR': M_NEIGHBOR,\n",
        "        'SIGMA': SIGMA,\n",
        "        'INTERP_STEPS': INTERP_STEPS,\n",
        "        'TEMP': TEMP,\n",
        "        'TOP_P': TOP_P,\n",
        "        'BASE_ATTR': BASE_ATTR,\n",
        "    },\n",
        "    'anchors': anchor_idx,\n",
        "    'models': {},\n",
        "}\n",
        "\n",
        "for spec in VAE_SPECS:\n",
        "    model = load_model(spec.model_type, spec.ckpt_path, block_size=spec.block_size, bars=spec.bars_per_sample)\n",
        "\n",
        "    mus = []\n",
        "    for i in anchor_idx:\n",
        "        x, _bar, _attrs = ds[int(i)]\n",
        "        mu = encode_mu(model, np.asarray(x, dtype=np.int64)[: spec.block_size])\n",
        "        mus.append(mu)\n",
        "    mus = np.stack(mus, axis=0)\n",
        "\n",
        "    # Neighborhood sampling\n",
        "    feats_by_anchor: list[list[np.ndarray]] = []\n",
        "    for a_i in range(N_ANCHORS):\n",
        "        mu = mus[a_i]\n",
        "        feats = []\n",
        "        for j in range(M_NEIGHBOR):\n",
        "            z = mu + (SIGMA * np.random.randn(mu.shape[0]).astype(np.float32))\n",
        "            tokens = generate_with_z(spec.model_type, model, z=z, bars=spec.bars_per_sample, block=spec.block_size, seed=1000 + a_i * 100 + j)\n",
        "            feats.append(feature_vector_from_tokens(tokens, bars=spec.bars_per_sample))\n",
        "        feats_by_anchor.append(feats)\n",
        "\n",
        "    def avg_pairwise_dist(X: np.ndarray) -> float:\n",
        "        if len(X) < 2:\n",
        "            return float('nan')\n",
        "        rng = np.random.default_rng(123)\n",
        "        pairs = 300\n",
        "        acc = 0.0\n",
        "        for _ in range(pairs):\n",
        "            i, j = rng.integers(0, len(X), size=2)\n",
        "            if i == j:\n",
        "                continue\n",
        "            acc += float(np.linalg.norm(X[i] - X[j]))\n",
        "        return acc / max(1, pairs)\n",
        "\n",
        "    within = []\n",
        "    for a_i in range(N_ANCHORS):\n",
        "        X = np.stack(feats_by_anchor[a_i], axis=0)\n",
        "        within.append(avg_pairwise_dist(X))\n",
        "    within_mean = float(np.mean(within))\n",
        "\n",
        "    centroids = np.stack([np.mean(np.stack(f, axis=0), axis=0) for f in feats_by_anchor], axis=0)\n",
        "    between = avg_pairwise_dist(centroids)\n",
        "\n",
        "    summary['models'][spec.name] = {\n",
        "        'within_mean': within_mean,\n",
        "        'within_by_anchor': within,\n",
        "        'between_centroid': float(between),\n",
        "    }\n",
        "\n",
        "out_path = OUT_DIR / 'latent_sampling_summary.json'\n",
        "out_path.write_text(json.dumps(summary, indent=2), encoding='utf-8')\n",
        "out_path\n"
      ]
    }
  ],
